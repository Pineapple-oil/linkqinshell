import { Button, LineEdit } from "std-widgets.slint";

component FieldLabel inherits Text {
    color: #1f2937;
    font-size: 12px;
    font-weight: 700;
    height: 18px;
    vertical-alignment: center;
}

component FormInput inherits LineEdit {
    height: 30px;
}

component PanelTitle inherits Text {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
    height: 22px;
    vertical-alignment: center;
}

export component MainWindow inherits Window {
    title: "LinkQinShell";
    width: 1200px;
    height: 760px;

    in-out property <string> status_text: "Ready";
    in-out property <string> connection_summary: "No saved connections";
    in-out property <string> connection_list_text: "No saved connections";
    in-out property <string> master_password: "";
    in-out property <string> connection_name: "";
    in-out property <string> connection_host: "";
    in-out property <string> connection_port: "22";
    in-out property <string> connection_username: "";
    in-out property <string> connection_password: "";
    callback new_connection_requested();
    callback quick_connect_requested();
    callback save_connection_requested(string, string, string, string, string, string);
    callback connect_first_requested(string);

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #f3f6f9;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 44px;
        background: #17202a;

        Text {
            x: 12px;
            y: 0px;
            width: 210px;
            height: 44px;
            text: "LinkQinShell";
            color: white;
            font-size: 18px;
            vertical-alignment: center;
        }

        Button {
            x: root.width - 202px;
            y: 7px;
            width: 88px;
            height: 30px;
            text: "New";
            clicked => { root.new_connection_requested(); }
        }

        Button {
            x: root.width - 104px;
            y: 7px;
            width: 92px;
            height: 30px;
            text: "Quick";
            clicked => { root.quick_connect_requested(); }
        }
    }

    Rectangle {
        x: 0px;
        y: 44px;
        width: 320px;
        height: root.height - 74px;
        background: #ffffff;
        border-color: #d6dde6;
        border-width: 1px;

        PanelTitle { x: 12px; y: 10px; width: 296px; text: "Connections"; }
        FormInput { x: 12px; y: 40px; width: 296px; placeholder-text: "Search connections"; }

        Rectangle {
            x: 12px;
            y: 82px;
            width: 296px;
            height: 104px;
            background: #eef3f8;
            border-radius: 6px;
            border-color: #d6dde6;
            border-width: 1px;

            Text {
                x: 8px;
                y: 8px;
                width: 280px;
                height: 20px;
                text: root.connection_summary;
                color: #111827;
                font-size: 13px;
            }

            Text {
                x: 8px;
                y: 38px;
                width: 280px;
                height: 54px;
                text: root.connection_list_text;
                color: #526173;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        FieldLabel { x: 12px; y: 200px; width: 296px; text: "Master password"; }
        FormInput {
            x: 12px;
            y: 222px;
            width: 296px;
            placeholder-text: "At least 8 characters";
            text <=> root.master_password;
        }

        FieldLabel { x: 12px; y: 268px; width: 296px; text: "New SSH connection"; }
        FormInput {
            x: 12px;
            y: 292px;
            width: 296px;
            placeholder-text: "Connection name";
            text <=> root.connection_name;
        }
        FormInput {
            x: 12px;
            y: 330px;
            width: 296px;
            placeholder-text: "Host or IP";
            text <=> root.connection_host;
        }
        FormInput {
            x: 12px;
            y: 368px;
            width: 86px;
            placeholder-text: "Port";
            text <=> root.connection_port;
        }
        FormInput {
            x: 106px;
            y: 368px;
            width: 202px;
            placeholder-text: "Username";
            text <=> root.connection_username;
        }
        FormInput {
            x: 12px;
            y: 406px;
            width: 296px;
            placeholder-text: "SSH password";
            text <=> root.connection_password;
        }

        Button {
            x: 12px;
            y: 452px;
            width: 142px;
            height: 32px;
            text: "Save SSH";
            clicked => {
                root.save_connection_requested(
                    root.master_password,
                    root.connection_name,
                    root.connection_host,
                    root.connection_port,
                    root.connection_username,
                    root.connection_password
                );
            }
        }

        Button {
            x: 166px;
            y: 452px;
            width: 142px;
            height: 32px;
            text: "Connect First";
            clicked => { root.connect_first_requested(root.master_password); }
        }
    }

    Rectangle {
        x: 320px;
        y: 44px;
        width: root.width - 620px;
        height: root.height - 74px;
        background: #0b1117;

        Rectangle {
            x: 8px;
            y: 8px;
            width: 160px;
            height: 28px;
            background: #202a36;
            border-radius: 4px;

            Text {
                text: "Local workspace";
                color: #d9e2ec;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12px;
            }
        }

        Text {
            x: 18px;
            y: 56px;
            width: parent.width - 36px;
            height: 120px;
            text: "Terminal output will appear here after an SSH session connects.\n\nSave a connection on the left, enter the same master password, then use Connect First.";
            color: #9fb0c3;
            font-family: "Consolas";
            font-size: 14px;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: root.width - 300px;
        y: 44px;
        width: 300px;
        height: root.height - 74px;
        background: #ffffff;
        border-color: #d6dde6;
        border-width: 1px;

        PanelTitle { x: 10px; y: 10px; width: 280px; text: "SFTP"; }

        Rectangle {
            x: 10px;
            y: 44px;
            width: 280px;
            height: 110px;
            background: #f8fafc;
            border-color: #d6dde6;
            border-width: 1px;
            border-radius: 6px;

            Text { x: 8px; y: 8px; width: 260px; height: 20px; text: "Remote files"; font-size: 12px; color: #111827; }
            Text {
                x: 8px;
                y: 44px;
                width: 260px;
                height: 54px;
                text: "Directory listing, upload, download, rename, mkdir and delete are backend P0 operations.";
                font-size: 11px;
                color: #526173;
                wrap: word-wrap;
            }
        }

        PanelTitle { x: 10px; y: 174px; width: 280px; text: "Monitor"; }

        Rectangle {
            x: 10px;
            y: 208px;
            width: 280px;
            height: 92px;
            background: #f8fafc;
            border-color: #d6dde6;
            border-width: 1px;
            border-radius: 6px;

            Text { x: 8px; y: 8px; width: 260px; height: 20px; text: "P0 status panel"; font-size: 12px; color: #111827; }
            Text {
                x: 8px;
                y: 42px;
                width: 260px;
                height: 40px;
                text: "Resource monitoring expands after SSH/SFTP stability.";
                font-size: 11px;
                color: #526173;
                wrap: word-wrap;
            }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height - 30px;
        width: root.width;
        height: 30px;
        background: #e7edf3;
        border-color: #cbd5e1;
        border-width: 1px;

        Text {
            x: 10px;
            y: 0px;
            width: root.width - 20px;
            height: 30px;
            text: root.status_text;
            color: #334155;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
