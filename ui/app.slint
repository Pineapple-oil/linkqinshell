import { Button, LineEdit } from "std-widgets.slint";

component FieldLabel inherits Text {
    color: #1f2937;
    font-size: 12px;
    font-weight: 700;
    height: 18px;
    vertical-alignment: center;
}

component FormInput inherits LineEdit {
    height: 30px;
}

component PanelTitle inherits Text {
    color: #111827;
    font-size: 14px;
    font-weight: 700;
    height: 22px;
    vertical-alignment: center;
}

export component MainWindow inherits Window {
    title: "LinkQinShell";
    width: 1200px;
    height: 760px;

    in-out property <string> status_text: "Ready";
    in-out property <string> connection_summary: "No saved connections";
    in-out property <string> connection_list_text: "No saved connections";
    in-out property <string> master_password: "";
    in-out property <string> connection_name: "";
    in-out property <string> connection_host: "";
    in-out property <string> connection_port: "22";
    in-out property <string> connection_username: "";
    in-out property <string> connection_password: "";
    callback new_connection_requested();
    callback quick_connect_requested();
    callback save_connection_requested(string, string, string, string, string, string);
    callback connect_first_requested(string);

    Rectangle {
        background: #f4f6f8;

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 44px;
                background: #17202a;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;

                    Text {
                        width: 190px;
                        text: "LinkQinShell";
                        color: white;
                        font-size: 18px;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 1px; background: #334155; }

                    Rectangle {}

                    Button {
                        width: 92px;
                        height: 30px;
                        text: "New";
                        clicked => { root.new_connection_requested(); }
                    }

                    Button {
                        width: 92px;
                        height: 30px;
                        text: "Quick";
                        clicked => { root.quick_connect_requested(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;

                Rectangle {
                    width: 320px;
                    background: #ffffff;
                    border-color: #d6dde6;
                    border-width: 1px;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 7px;

                        PanelTitle {
                            text: "Connections";
                        }

                        FormInput {
                            placeholder-text: "Search connections";
                        }

                        Rectangle {
                            height: 104px;
                            background: #eef3f8;
                            border-radius: 6px;
                            border-color: #d6dde6;
                            border-width: 1px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 3px;
                                Text { text: root.connection_summary; color: #111827; font-size: 13px; }
                                Text {
                                    text: root.connection_list_text;
                                    color: #526173;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        FieldLabel { text: "Master password"; }
                        FormInput {
                            placeholder-text: "At least 8 characters";
                            text <=> root.master_password;
                        }

                        Rectangle { height: 5px; }

                        FieldLabel { text: "New SSH connection"; }
                        FormInput {
                            placeholder-text: "Connection name";
                            text <=> root.connection_name;
                        }
                        FormInput {
                            placeholder-text: "Host or IP";
                            text <=> root.connection_host;
                        }

                        HorizontalLayout {
                            height: 30px;
                            spacing: 6px;
                            FormInput {
                                width: 78px;
                                placeholder-text: "Port";
                                text <=> root.connection_port;
                            }
                            FormInput {
                                placeholder-text: "Username";
                                text <=> root.connection_username;
                            }
                        }

                        FormInput {
                            placeholder-text: "SSH password";
                            text <=> root.connection_password;
                        }

                        Button {
                            height: 32px;
                            text: "Save SSH";
                            clicked => {
                                root.save_connection_requested(
                                    root.master_password,
                                    root.connection_name,
                                    root.connection_host,
                                    root.connection_port,
                                    root.connection_username,
                                    root.connection_password
                                );
                            }
                        }

                        Button {
                            height: 32px;
                            text: "Connect First";
                            clicked => { root.connect_first_requested(root.master_password); }
                        }

                        Rectangle {}
                    }
                }

                Rectangle {
                    background: #0b1117;

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 36px;
                            background: #202a36;

                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                Rectangle {
                                    width: 160px;
                                    height: 28px;
                                    background: #0b1117;
                                    border-radius: 4px;
                                    Text {
                                        text: "Local workspace";
                                        color: #d9e2ec;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            background: #0b1117;
                            Text {
                                text: "Terminal output will appear here after an SSH session connects.\n\nSave a connection on the left, enter the same master password, then use Connect First.";
                                color: #9fb0c3;
                                font-family: "Consolas";
                                font-size: 14px;
                                x: 18px;
                                y: 18px;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 300px;
                    background: #ffffff;
                    border-color: #d6dde6;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 10px;

                        PanelTitle {
                            text: "SFTP";
                        }

                        Rectangle {
                            height: 110px;
                            background: #f8fafc;
                            border-color: #d6dde6;
                            border-width: 1px;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text { text: "Remote files"; font-size: 12px; color: #111827; }
                                Text { text: "Directory listing, upload, download, rename, mkdir and delete are backend P0 operations."; font-size: 11px; color: #526173; wrap: word-wrap; }
                            }
                        }

                        PanelTitle {
                            text: "Monitor";
                        }

                        Rectangle {
                            height: 92px;
                            background: #f8fafc;
                            border-color: #d6dde6;
                            border-width: 1px;
                            border-radius: 6px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 4px;
                                Text { text: "P0 status panel"; font-size: 12px; color: #111827; }
                                Text { text: "Resource monitoring expands after SSH/SFTP stability."; font-size: 11px; color: #526173; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 30px;
                background: #e7edf3;
                border-color: #cbd5e1;
                border-width: 1px;

                Text {
                    text: root.status_text;
                    color: #334155;
                    font-size: 11px;
                    x: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
